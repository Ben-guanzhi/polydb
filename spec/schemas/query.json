{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polydb.dev/schemas/query.json",
  "title": "PolyDB Query",
  "description": "Query execution request and result DTOs",
  "definitions": {
    "QueryRequest": {
      "type": "object",
      "required": ["sql"],
      "properties": {
        "sql": { "type": "string", "description": "SQL statement to execute" },
        "params": {
          "type": "array",
          "items": { "$ref": "common.json#/definitions/Value" },
          "description": "Positional bind parameters"
        },
        "connection_id": { "$ref": "common.json#/definitions/ConnectionId" },
        "query_id": {
          "type": "string",
          "description": "Optional client-provided query identifier (uuid). Server echoes it in the X-Query-ID response header. When omitted the server generates one. Use POST /api/queries/{query_id}/cancel to cancel an in-flight HTTP query."
        },
        "schema": { "type": "string", "description": "Schema context for the query" },
        "pagination": { "$ref": "common.json#/definitions/PaginationParams" },
        "timeout_ms": { "type": "integer", "minimum": 0, "description": "Query timeout in milliseconds (0 = no timeout)" },
        "max_rows": { "type": "integer", "minimum": 0, "description": "Maximum rows to return (0 = use server default)" }
      }
    },
    "QueryResult": {
      "type": "object",
      "required": ["columns", "rows", "affected_rows", "execution_time_ms"],
      "properties": {
        "columns": {
          "type": "array",
          "items": { "$ref": "#/definitions/ResultColumn" },
          "description": "Column metadata for the result set"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "common.json#/definitions/Value" }
          },
          "description": "Row data as arrays of values"
        },
        "affected_rows": { "type": "integer", "description": "Number of rows affected (for DML)" },
        "execution_time_ms": { "type": "number", "description": "Server-side execution time" },
        "truncated": { "type": "boolean", "description": "True if results were truncated due to max_rows" },
        "total_rows": { "type": ["integer", "null"], "description": "Total rows available (if known, for pagination)" },
        "has_more": { "type": "boolean", "description": "Whether more rows are available" },
        "statement_type": {
          "type": "string",
          "enum": ["select", "insert", "update", "delete", "ddl", "other"],
          "description": "Type of SQL statement executed"
        }
      }
    },
    "ResultColumn": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "description": "Column name or alias" },
        "table": { "type": ["string", "null"], "description": "Source table name if applicable" },
        "type": { "type": "string", "description": "Database-specific type name" },
        "generic_type": {
          "type": "string",
          "enum": [
            "boolean", "smallint", "integer", "bigint",
            "float", "double", "decimal", "numeric",
            "char", "varchar", "text", "binary", "varbinary", "blob",
            "date", "time", "datetime", "timestamp", "interval",
            "json", "jsonb", "xml", "uuid", "array", "enum", "other"
          ]
        },
        "nullable": { "type": ["boolean", "null"] }
      }
    },
    "BatchQueryRequest": {
      "type": "object",
      "required": ["statements", "stop_on_error"],
      "properties": {
        "statements": {
          "type": "array",
          "items": { "$ref": "#/definitions/QueryRequest" },
          "description": "Multiple SQL statements to execute in order"
        },
        "connection_id": { "$ref": "common.json#/definitions/ConnectionId" },
        "stop_on_error": { "type": "boolean", "default": true, "description": "Stop execution on first error" }
      }
    },
    "BatchQueryResult": {
      "type": "object",
      "required": ["results", "total_execution_time_ms"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/QueryResult" },
              { "$ref": "error.json#/definitions/PolyDBError" }
            ]
          },
          "description": "Results in same order as statements; errors if stop_on_error=false"
        },
        "total_execution_time_ms": { "type": "number" }
      }
    },
    "FilterOperator": {
      "type": "string",
      "description": "Filter operators for table data browsing (behavior.md §13)",
      "enum": ["eq", "ne", "lt", "le", "gt", "ge", "like", "not_like", "in", "not_in", "between", "null", "not_null"]
    },
    "FilterLogic": {
      "type": "string",
      "enum": ["and", "or"],
      "default": "and",
      "description": "How multiple conditions combine"
    },
    "SortDirection": {
      "type": "string",
      "enum": ["asc", "desc"]
    },
    "FilterCondition": {
      "type": "object",
      "required": ["column", "op"],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1,
          "description": "Column name; server quotes it as an identifier (never interpolated raw)"
        },
        "op": { "$ref": "#/definitions/FilterOperator" },
        "value": {
          "$ref": "common.json#/definitions/Value",
          "description": "Single value for eq/ne/lt/le/gt/ge/like/not_like; ignored for null/not_null"
        },
        "second_value": {
          "$ref": "common.json#/definitions/Value",
          "description": "Upper bound for between"
        },
        "values": {
          "type": "array",
          "items": { "$ref": "common.json#/definitions/Value" },
          "description": "List for in/not_in (must be non-empty)"
        }
      }
    },
    "OrderClause": {
      "type": "object",
      "required": ["column", "dir"],
      "properties": {
        "column": { "type": "string", "minLength": 1 },
        "dir": { "$ref": "#/definitions/SortDirection" }
      }
    },
    "TableRowsRequest": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Projection; omitted/empty = all columns"
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/FilterCondition" },
          "description": "Filter conditions combined per logic"
        },
        "logic": { "$ref": "#/definitions/FilterLogic" },
        "order_by": {
          "type": "array",
          "items": { "$ref": "#/definitions/OrderClause" }
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Rows to skip"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 200,
          "description": "Max rows to return; server clamps to 10000 (behavior.md §13)"
        }
      }
    },
    "TableRowsResult": {
      "type": "object",
      "required": ["columns", "rows", "offset", "has_more"],
      "properties": {
        "columns": {
          "type": "array",
          "items": { "$ref": "#/definitions/ResultColumn" }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "common.json#/definitions/Value" }
          }
        },
        "offset": { "type": "integer", "minimum": 0 },
        "has_more": {
          "type": "boolean",
          "description": "true when more rows exist beyond offset+limit (server fetches limit+1 and trims)"
        },
        "total_estimate": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional engine-estimated row count when cheaply available"
        },
        "execution_time_ms": { "type": "number" }
      }
    },
    "TableCountResult": {
      "type": "object",
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
