{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polydb.dev/schemas/transaction.json",
  "title": "PolyDB Transaction",
  "description": "Transaction management DTOs",
  "definitions": {
    "TransactionInfo": {
      "type": "object",
      "required": ["id", "connection_id", "status", "started_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "connection_id": { "$ref": "common.json#/definitions/ConnectionId" },
        "status": {
          "type": "string",
          "enum": ["active", "committed", "rolled_back"]
        },
        "started_at": { "type": "string", "format": "date-time" },
        "isolation_level": { "$ref": "#/definitions/IsolationLevel" }
      }
    },
    "BeginTransactionRequest": {
      "type": "object",
      "required": ["connection_id"],
      "properties": {
        "connection_id": { "$ref": "common.json#/definitions/ConnectionId" },
        "isolation_level": { "$ref": "#/definitions/IsolationLevel" }
      }
    },
    "IsolationLevel": {
      "type": "string",
      "enum": [
        "read_uncommitted",
        "read_committed",
        "repeatable_read",
        "serializable"
      ],
      "default": "read_committed"
    }
  }
}
