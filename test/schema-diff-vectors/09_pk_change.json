  "target": {
    "kind": "mysql",
    "schema": "app",
    "tables": [
      {
        "name": "t",
        "type": "table",
        "columns": [
          { "name": "a", "data_type": "int", "nullable": false, "ordinal_position": 1 },
          { "name": "b", "data_type": "int", "nullable": false, "ordinal_position": 2 }
        ],
        "indexes": [
          { "name": "PRIMARY", "unique": true, "primary": true, "columns": [ { "name": "b", "position": 1 } ] }
        ],
        "foreign_keys": []
      }
