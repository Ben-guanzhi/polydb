# ─── Build artifacts ───────────────────────────────────────
# Rust
/rust/target/
/rust/target-gnu/
# root target/ 是历史日志残留（target/logs），全部排除
/target/
# Web
/web/node_modules/
/web/dist/
*.tsbuildinfo
# Go
/go/bin/

# ─── Vendored local tools（Windows 专属二进制，不入库）─────
/.tools/

# ─── 工具构建产物（协议生成器用 go run . / go build . 重建）──
/tools/genprotocol/*.exe

# ─── IDE / Agent 工具本地状态（不入库）─────────────────────
/.idea/
/.qoder/

# ─── Logs & scratch ────────────────────────────────────────
*.log
_agt_tmp.md
agents_full.txt

# ─── Data & secrets（红线：绝不入库）───────────────────────
*.db
*.db-wal
*.db-shm
keyring.bin

# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db